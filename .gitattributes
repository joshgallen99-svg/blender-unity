* text=auto
*.cs text diff=csharp
*.unity text merge=unityyamlmerge eol=lf
*.prefab text merge=unityyamlmerge eol=lf
*.asset text merge=unityyamlmerge eol=lf
*.meta text eol=lf
# Binary assets (kept small and committed directly; Git LFS is not used so cloud builds
# don't consume LFS bandwidth quota).
*.blend binary
*.fbx binary
*.glb binary
*.obj binary
*.png binary
*.jpg binary
*.psd binary
*.tga binary
*.exr binary
*.r16 binary
*.wav binary
*.mp3 binary
*.ogg binary
